{
  "name": "taskly",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev:build": "node -e \"require('fs').rmSync('../wwwroot', { recursive: true, force: true })\"",
    "dev:build": "vite build --mode development",
    "predev:watch": "node -e \"require('fs').rmSync('../wwwroot', { recursive: true, force: true })\"",
    "dev:watch": "vite build --mode development --watch",
    "prebuild": "node -e \"require('fs').rmSync('../wwwroot', { recursive: true, force: true })\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "ci": "npm run lint && npm run build && npm run test",
    "postinstall": "patch-package"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/ssr": "^22.1.6",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "chart.js": "^4.5.1",
    "isbot": "^5.1.27",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.1",
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular/build": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "baseline-browser-mapping": "^2.9.17",
    "eslint": "^10.9.1",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.0"
  }
}
