{
  "Security": {
    "Cors": {
      "AllowedOrigins": [],
      "AllowedMethods": [
        "GET",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type"
      ],
      "ExposedHeaders": [],
      "PreflightMaxAgeSeconds": 600,
      "AllowCredentials": false,
      "StrictOriginValidation": true
    },
    "Csp": {
      "Enabled": true,
      "ReportOnly": false,
      "AllowInlineStyles": true
    },
    "EnableHstsInDevelopment": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
