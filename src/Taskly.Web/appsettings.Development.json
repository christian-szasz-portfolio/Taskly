{
  "DetailedErrors": true,
  "Security": {
    "Cors": {
      "AllowedOrigins": [
        "https://localhost:1998",
        "http://localhost:1998",
        "http://localhost:2026"
      ],
      "AllowedMethods": [
        "GET",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type"
      ],
      "ExposedHeaders": [],
      "PreflightMaxAgeSeconds": 600,
      "AllowCredentials": false,
      "StrictOriginValidation": false
    },
    "Csp": {
      "Enabled": true,
      "ReportOnly": false,
      "AllowInlineStyles": true
    },
    "EnableHstsInDevelopment": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
