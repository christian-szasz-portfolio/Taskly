{
  "Security": {
    "Cors": {
      "AllowedOrigins": [
        "https://localhost:1998"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With",
        "X-XSRF-TOKEN"
      ],
      "ExposedHeaders": [
        "X-Pagination",
        "X-Request-Id"
      ],
      "PreflightMaxAgeSeconds": 600,
      "AllowCredentials": true,
      "StrictOriginValidation": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
